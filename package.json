{
  "name": "s1-battle",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "Robot arena where four combat bots fight using realtime Jev (TypeSafe System One) decisions",
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "probe": "tsx scripts/probe-jev.ts",
    "league": "tsx scripts/league/league.ts",
    "improve": "scripts/league/loop.sh",
    "bet:check": "tsx scripts/betting-check.ts",
    "bet:sim": "tsx scripts/betting-sim.ts",
    "bet:house": "tsx scripts/house-check.ts",
    "api:docs": "tsx scripts/api-docs.ts",
    "api:check": "tsx scripts/api-docs.ts --check",
    "api:lint": "npx -y @redocly/cli@1 lint docs/api/openapi.yaml && npx -y @asyncapi/cli@2 validate docs/api/asyncapi.yaml"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.7.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/three": "^0.170.0",
    "concurrently": "^9.1.0",
    "marked": "^18.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
